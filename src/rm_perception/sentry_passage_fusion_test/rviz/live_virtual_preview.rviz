Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Map
      Name: "Original SLAM Map (toggle to compare)"
      Enabled: false
      Value: false
      Draw Behind: true
      Alpha: 1
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: "Virtual Passage Evidence (NOT permission)"
      Enabled: false
      Value: false
      Draw Behind: false
      Alpha: 0.65
      Color Scheme: map
      Topic:
        Value: /passage_fusion_test/preview_static_clearing
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: "VIRTUAL Final Costmap (NO ROBOT CONTROL)"
      Enabled: true
      Value: true
      Draw Behind: false
      Alpha: 1
      Color Scheme: map
      Topic:
        Value: /passage_fusion_test/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Use Timestamp: false
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 50
      X: 0
      Y: 0
      Angle: 0
    Saved: []
Window Geometry:
  Width: 1100
  Height: 800
